  "votos_individuales": [
    {
      "voto_individual_id": "VI_67c69e091a13052a",
      "votacion_id": "V_613840fee7458459",
      "legislador_id": "L_f80cabf14ed274d4",
      "nombre_fuente": "CAMACHO CALIZAYA FREDDY",
      "voto": "SI",
      "fuente_id": "F_c63344051eb48f90",
      "pagina": 52,
      "extracto": "DIP . CAMACHO CALIZAYA FREDDY: Señor Presidente, la Bancada de Autonomía para Bolivia SÚMATE, a pesar de no haber sido contemplado en ninguna de las nóminas, quiere contribuir a nuevo clima, al nuevo ciclo que está viviendo nuestro país, que debe vivir, que es un ciclo de reconciliación. En ese sentido, vamos a ser constructivos en todo aquello que sea positivo para el país y vamos a criticar lo negativo. En ese sentido, nuestro voto es por aprobación.",
      "confianza": 1.0,
      "descripcion": "Elección nominal de la Directiva: bloque de mayoría",
      "resultado": "APROBADO",
      "requiere_revision": 1,
      "fecha": "2025-11-06",
      "numero": 1,
      "fuente_url": "https://diputados.gob.bo/wp-content/uploads/2026/07/DIAGRAMACION-EL-REDACTOR-NOVIEMBRE-HR-22986-26-05-26.pdf"
    },
    {
      "voto_individual_id": "VI_1837b0290e0120c4",
      "votacion_id": "V_187e487967eae412",
      "legislador_id": "L_f80cabf14ed274d4",
      "nombre_fuente": "CAMACHO CALIZAYA FREDDY",
      "voto": "SI",
      "fuente_id": "F_c63344051eb48f90",
      "pagina": 65,
      "extracto": "DIP . CAMACHO CALIZAYA FREDDY: Hola. Sí, Presidente. Hemos vivido 20 años de atropello de las minorías por unas mayorías que afortunadamente ahora ya no están. Una recomendación a las nuevas mayorías: no repitan, por favor, el mismo camino. El respeto a las minorías es democracia. Sin embargo, tenemos el encargo de nuestro líder Manfred Reyes Villa de contribuir positivamente en esta nueva etapa. Por eso, mi voto es por la aprobación.",
      "confianza": 1.0,
      "descripcion": "Elección nominal de la Directiva: bloque de minoría",
      "resultado": "APROBADO",
      "requiere_revision": 0,
      "fecha": "2025-11-06",
