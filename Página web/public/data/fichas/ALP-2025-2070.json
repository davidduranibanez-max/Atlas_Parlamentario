  "votos_individuales": [
    {
      "voto_individual_id": "VI_473566b79a1dfc4d",
      "votacion_id": "V_613840fee7458459",
      "legislador_id": "L_4f27a61b38f7d718",
      "nombre_fuente": "ZEGARRA BERNAL EDGAR JOSE",
      "voto": "SI",
      "fuente_id": "F_c63344051eb48f90",
      "pagina": 56,
      "extracto": "DIP . ZEGARRA BERNAL EDGAR JOSE: Palabra, señor Presidente. Colegas Diputados, hoy libre da una muestra más de que estamos empezando a construir Bolivia a través del consenso. En la diversidad queremos encontrar la unidad y el consenso. Ese es el mensaje que hemos dado nosotros como Alianza. Y aquí están las muestras. Queremos reconstruir Bolivia, pero en unidad. Hay que respetar la democracia. Va a haber diferentes modos de pensar, pero la unidad nos va a hacer fuertes en la diversidad. Hay que tener respeto por las ideas que otros tienen, pero hay que construir la unidad. 57 NOVIEMBRE 2025 EL REDACTOR CÁMARA DE DIPUTADOS Venimos desde las provincias a la ciudad a decirle a Bolivia que Bolivia merece la unidad de todos nosotros. Primero pensando en Bolivia, después pensando en los apetitos personales y en los partidos políticos. Hay que construir este país después que han destrozado 20 años. Aprobado, señor Presidente. Muchas gracias.",
      "confianza": 1.0,
      "descripcion": "Elección nominal de la Directiva: bloque de mayoría",
      "resultado": "APROBADO",
      "requiere_revision": 1,
      "fecha": "2025-11-06",
      "numero": 1,
      "fuente_url": "https://diputados.gob.bo/wp-content/uploads/2026/07/DIAGRAMACION-EL-REDACTOR-NOVIEMBRE-HR-22986-26-05-26.pdf"
    },
    {
      "voto_individual_id": "VI_03a8dfd71a44f0b1",
      "votacion_id": "V_187e487967eae412",
      "legislador_id": "L_4f27a61b38f7d718",
      "nombre_fuente": "ZEGARRA BERNAL EDGAR JOSE",
      "voto": "SI",
      "fuente_id": "F_c63344051eb48f90",
